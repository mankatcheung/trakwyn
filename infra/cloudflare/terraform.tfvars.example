# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is secret
# (the Cloudflare token comes from the environment, TF_VAR_cloudflare_api_token),
# but email_routing_rules names personal inboxes, so keep it out of the repo.
zone_id = "<32-hex zone id>" # trakwyn.com → Overview → API

# First apply only: adopt the records already in the zone. List their IDs as
# README.md shows, then empty this map once they are in state.
# record_import_ids = {
#   apex_a_1              = "..."
#   apex_a_2              = "..."
#   www                   = "..."
#   api                   = "..."
#   brevo_dkim_1          = "..."
#   brevo_dkim_2          = "..."
#   dmarc                 = "..."
#   brevo_verification    = "..."
#   google_verification   = "..."
# }

# Email Routing forwarding rules, keyed by the rule's name in the dashboard.
# Kept here rather than in email_routing.tf because forward_to is a personal
# inbox. Each forward_to must already be a verified destination address.
# email_routing_rules = {
#   hello = { address = "hello@trakwyn.com", forward_to = "you@example.com" }
# }

# First apply only: adopt the rules already in the zone (README.md), then
# empty this map once they are in state.
# email_routing_rule_import_ids = {
#   hello = "..."
# }
