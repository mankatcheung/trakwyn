# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is secret:
# the personal API key comes from the environment (TF_VAR_posthog_api_key).
organization_id = "00000000-0000-0000-0000-000000000000"
project_id      = "12345"
project_name    = "Trakwyn"

# EU cloud management API; only change for a self-hosted instance.
# posthog_host = "https://eu.posthog.com"

# Mobile release health alert (JEF-368). Numeric user IDs, not UUIDs; see
# README.md for where to find them.
release_health_alert_user_ids = [12345]
# crash_free_sessions_alert_percent = 99
# crash_alert_min_sessions          = 50
# crash_alert_app_version           = "1.2.0"
