# Copy to .envrc (gitignored) and fill in. Load with `source .envrc`, or let
# direnv do it on `cd`. Never put the token in terraform.tfvars.
export TF_VAR_axiom_api_token=xaat-...
# Same value as the API's ALERT_WEBHOOK_SECRET (Secret Manager alert-webhook-secret).
export TF_VAR_alert_webhook_secret=...
