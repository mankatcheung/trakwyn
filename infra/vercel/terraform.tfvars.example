# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is secret:
# the Vercel token comes from the environment (TF_VAR_vercel_api_token).
team_id      = "team_xxxxxxxxxxxxxxxxxxxxxxxx" # VERCEL_ORG_ID
project_id   = "prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx" # VERCEL_WEB_PROJECT_ID
project_name = "trakwyn-web"
state_bucket = "<project-id>-tfstate"

# The public Blob store (avatars). All three must match the live store
# exactly, or the plan replaces it (README.md, "Adopting the Blob store").
blob_store_id     = "store_xxxxxxxxxxxxxxxx"
blob_store_name   = "<name as Vercel shows it>"
blob_store_region = "<region, e.g. fra1>"

# The private Blob store (documents, JEF-51) is created by this root, in the
# same region. Only its name can be chosen; this is the default.
# documents_blob_store_name = "trakwyn-documents"

# First apply only: adopt the env vars already set in the dashboard. List
# their IDs as README.md shows, then empty this map once they are in state.
# env_var_import_ids = {
#   VITE_API_URL      = "..."
#   VITE_POSTHOG_HOST = "..."
#   VITE_POSTHOG_KEY  = "..."
# }

# Defaults, shown for reference.
# production_domain = "www.trakwyn.com"
# apex_domain       = "trakwyn.com" # null if the project has no apex domain
# api_url           = "https://api.trakwyn.com/graphql"
# posthog_host      = "https://eu.i.posthog.com"

# Cloudflare Turnstile site key (JEF-401): `terraform output -raw
# turnstile_site_key` in infra/cloudflare, which creates the widget. Its secret
# key goes to infra/gcp's `turnstile-secret-key` secret.
# turnstile_site_key = ""
