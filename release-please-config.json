{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ef813809b8a7d4d30bdb7fd7b3bb3f9482d99405",
  "separate-pull-requests": true,
  "group-pull-request-title-pattern": "chore: release server",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "server",
      "components": ["api", "web"]
    }
  ],
  "packages": {
    "apps/api": {
      "release-type": "simple",
      "component": "api",
      "bump-minor-pre-major": true
    },
    "apps/web": {
      "release-type": "simple",
      "component": "web",
      "bump-minor-pre-major": true
    },
    "apps/extension": {
      "release-type": "node",
      "component": "clipper",
      "bump-minor-pre-major": true
    },
    "apps/mobile": {
      "release-type": "node",
      "component": "mobile",
      "bump-minor-pre-major": true
    },
    "apps/cli": {
      "release-type": "node",
      "component": "cli",
      "bump-minor-pre-major": true
    }
  }
}
