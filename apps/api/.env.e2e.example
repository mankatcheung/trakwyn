# The API's env for the Playwright e2e run (JEF-656). The one place these values
# are written: CI's `e2e` job copies this file to apps/api/.env, and a local run
# copies it to the gitignored apps/api/.env.e2e (`pnpm setup:worktree` does that
# for a worktree, with its own ports), which apps/web/e2eEnv.ts hands to the API
# server. Every secret is a placeholder; the job's servers and database live and
# die with the runner, so none of this protects anything.
#
# The `e2e-only-` prefix is what .gitleaks.toml allows: a new secret-looking
# value needs it too.
#
# DATABASE_URL is the one value CI overrides. Locally it is a PGlite directory,
# so e2e needs no Docker; the `e2e` job sets Postgres on the job itself, so the
# API under test talks to the database through the `pg` pool production uses.
# A PGlite database has to be migrated before the first run, with the API
# stopped (one process at a time):
#
#   pnpm --filter @trakwyn/api db:migrate:e2e
PORT=3001
NODE_ENV=development
DATABASE_URL=pglite:./.pglite-e2e
JWT_SECRET=e2e-only-jwt-secret
JWT_REFRESH_SECRET=e2e-only-refresh-secret
TOTP_ENCRYPTION_KEY=e2e-only-totp-encryption-key
LLM_API_KEY_ENCRYPTION_KEY=e2e-only-llm-encryption-key
STORAGE_PROVIDER=local
CACHE_PROVIDER=memory
EMAIL_PROVIDER=console
CORS_ORIGIN=http://localhost:3000
WEB_APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
COOKIE_DOMAIN=
GOOGLE_OAUTH_CLIENT_ID=e2e-fake-google-client-id
GITHUB_OAUTH_CLIENT_ID=e2e-fake-github-client-id
OAUTH_PROVIDER_MODE=fake
LLM_PROVIDER_MODE=fake
SEARCH_PROVIDER=fake
# Off is the default, so CI is unchanged; it is written down because the dev
# apps/api/.env turns it on, and a local run would otherwise lock offers and
# share links behind a plan.
PLANS_ENFORCED=false
