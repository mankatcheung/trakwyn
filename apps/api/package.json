{
  "name": "@trakwyn/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx watch -C development src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:apply": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:copy-from-turso": "tsx src/copyFromTurso.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/awilix": "^8.2.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/otel": "^0.20.1",
    "@fastify/static": "^10.1.3",
    "@opendocsg/pdf2md": "^0.2.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pothos/core": "^4.15.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tiptap/core": "^3.31.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "awilix": "^13.0.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^5.1.0",
    "graphql": "^16.14.2",
    "import-in-the-middle": "^3.5.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "mercurius": "^16.10.0",
    "nanoid": "^6.0.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.4.3",
    "@libsql/client": "^0.17.4",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@react-pdf/types": "^2.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
