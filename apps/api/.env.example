PORT=3001
NODE_ENV=development

# Database (local dev: file:./local.db, production: Turso URL)
DATABASE_URL=file:/absolute/path/to/trakwyn/apps/api/local.db
DATABASE_AUTH_TOKEN=

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Passphrase used to derive the key that encrypts TOTP secrets at rest
TOTP_ENCRYPTION_KEY=change-me-in-production

# Storage: 'local' for dev, 'vercel-blob' for production
STORAGE_PROVIDER=local

# Cache: 'memory' (default, per-process — fine for local dev/single instance)
# or 'redis' (shared across serverless instances via Upstash — required in
# production; see JEF-127). When 'redis', both Upstash values below are
# required or the app fails to start.
CACHE_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (used when STORAGE_PROVIDER=vercel-blob) — created automatically,
# and this value injected automatically, when you attach a Blob store to the
# Vercel project. Only needs to be set explicitly here for local dev against
# a real store. BLOB_PUBLIC_READ_WRITE_TOKEN is what the app actually reads
# (a public-access Blob store token); BLOB_READ_WRITE_TOKEN is unused.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=

# CORS
CORS_ORIGIN=http://localhost:3000

# The web app's public origin. Used to build the "review your active sessions"
# link in the new-device security email — that email refuses to send without
# it rather than guess, so an unset value means those alerts stop.
WEB_APP_ORIGIN=http://localhost:3000

# This API's own public origin, advertised as the OAuth issuer and endpoint
# URLs in the MCP discovery documents. Falls back to the request's Host header
# when unset, which is fine locally but caller-controlled in production.
API_ORIGIN=http://localhost:3001

# Shared Domain attribute for auth cookies, required when web and api are
# on different subdomains of the same site (e.g. www.trakwyn.com /
# api.trakwyn.com) so the browser attaches/reads them across both. Leave
# blank for local dev (host-only cookies on localhost work fine). In
# production, set to the registrable domain with a leading dot, e.g.
# .trakwyn.com.
COOKIE_DOMAIN=

# LLM (job description auto-fill and cover letter generation): bring-your-own-key
# — each user adds their own OpenRouter or Google AI key in Account settings.
# There is no shared/fallback key; these features are unavailable until a user
# sets one. Passphrase used to derive the key that encrypts those keys at rest.
# The API refuses to start an AI feature with this placeholder when NODE_ENV=production.
LLM_API_KEY_ENCRYPTION_KEY=change-me-in-production

# Where the API may connect on a user's behalf (custom LLM base URLs, job
# posting links). Unset: strict when NODE_ENV=production (private, loopback
# and link-local hosts refused; provider URLs must be https), permissive
# otherwise. Set to `permissive` only on a self-hosted instance that must
# reach a model on its own network, and understand that it re-opens SSRF
# from any signed-in user to that network.
OUTBOUND_URL_POLICY=

# Brevo email (for follow-up reminders, email/backup-email verification,
# password reset, and new-device login alerts). Leaving BREVO_API_KEY blank
# calls the real Brevo API with an empty key and throws — set
# EMAIL_PROVIDER=console instead to log outbound emails (with their
# confirmation URLs) rather than sending them.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Trakwyn

# Weekly digest trigger secret (set a strong random secret). Accepted
# alongside CRON_SECRET below, kept separate so a leaked digest secret can't
# also trigger reminders.
DIGEST_ADMIN_SECRET=

# Vercel Cron's reserved secret name — Vercel auto-injects this as
# `Authorization: Bearer $CRON_SECRET` when it invokes the digest/reminders
# routes on schedule (see apps/api/vercel.json `crons`). Only needs to be set
# here for local/manual triggering of those routes; on Vercel itself, set as
# a project env var.
CRON_SECRET=

# OAuth sign-in (Google/GitHub). Leave blank to disable — the /auth/oauth/*
# routes respond 503 "not configured" until both id/secret for a provider
# are set. Register a Google OAuth client at
# https://console.cloud.google.com/apis/credentials and a GitHub OAuth App
# at https://github.com/settings/developers; the callback URL to register
# with each is <API origin>/auth/oauth/google/callback (and .../github/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# VAPID keys for Web Push notifications (browser push). Generate a key pair:
#   npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@trakwyn.com

# Axiom (observability: traces, metrics). Logs are collected via Vercel's
# log drain integration — no pino transport needed. Leave
# AXIOM_TOKEN/AXIOM_DATASET blank to disable tracing entirely.
AXIOM_TOKEN=
# Events-type dataset, used for traces
AXIOM_DATASET=trakwyn-api
# Metrics-type dataset — a separate dataset kind in Axiom. Leave blank to
# disable metrics export while keeping traces and logs active.
AXIOM_METRICS_DATASET=trakwyn-api-metrics
