VITE_API_URL=/graphql

# Error and product analytics (JEF-349). Left blank, the app loads no
# PostHog SDK at all and reporting is a no-op — which is the intended state
# for local development and CI, not a broken config.
VITE_POSTHOG_KEY=
# Defaults to PostHog's EU ingestion host when unset.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Reported as `release` on every event, so an error can be tied to a
# deploy. On Vercel, leave it unset: vite.config.ts falls back to the
# commit SHA ($VERCEL_GIT_COMMIT_SHA) automatically. Unset elsewhere, events
# report `release: 'dev'`.
VITE_APP_RELEASE=

# Server-side error logging to Axiom (JEF-359): SSR renders and server
# functions in the Vercel function. Read from process.env on the server only.
# Never give these a VITE_ prefix, which would inline the token into the
# browser bundle. Nothing is sent unless NODE_ENV=production, so leave the
# token blank locally; production sets it by hand as a sensitive Vercel var
# (infra/vercel/README.md).
AXIOM_WEB_TOKEN=
AXIOM_WEB_DATASET=trakwyn-web
