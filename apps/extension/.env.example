# The API a build talks to. Left blank, `pnpm dev` uses http://localhost:3001/graphql.
# Every other build (`build`, `zip`) must set it, as the full /graphql URL: the
# release workflow reads it from the CLIPPER_API_URL repository variable. A build
# without it has no API URL and every request fails.
VITE_API_URL=

# Error reporting (JEF-387). Left blank, the extension reports nothing, which
# is the intended state for local development and CI, not a broken config.
# For a release build, use the same public `phc_` project key as the web app
# (`terraform -chdir=infra/posthog output -raw project_api_key`).
VITE_POSTHOG_KEY=
# Defaults to PostHog's EU ingestion host when unset.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
