{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Base images mirrored into Artifact Registry (JEF-406)",
      "managerFilePatterns": ["/^infra/base-images\\.txt$/"],
      "matchStrings": [
        "^(?<depName>[^\\s#:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})$"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "labels": ["Improvement"],
  "packageRules": [
    {
      "description": "One weekly PR for every GitHub Action bump (JEF-477)",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "schedule": ["before 6am on monday"]
    }
  ]
}
