{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "DATABASE_AUTH_TOKEN",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "STORAGE_PROVIDER",
    "CACHE_PROVIDER",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "R2_ENDPOINT",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "CORS_ORIGIN",
    "VITE_API_URL",
    "EXPO_PUBLIC_API_URL",
    "API_URL",
    "AXIOM_TOKEN",
    "AXIOM_DATASET",
    "AXIOM_METRICS_DATASET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "db:migrate:apply": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "test": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true
    },
    "codegen": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
